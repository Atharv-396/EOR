# =============================================================================
# EMP CLOUD — Client Environment Variables
# All VITE_ variables are embedded into the production bundle at build time.
# Never put secrets here.
# =============================================================================

# Backend API origin.
# Leave blank (or omit) for local dev — Vite proxies /api → localhost:3000.
# Set to your backend URL when frontend and backend are on separate domains:
#   VITE_API_BASE_URL=https://empcloud-api.vercel.app
# No trailing slash.
VITE_API_BASE_URL=

# Enable the Socket.IO realtime chat layer.
# Set to "true" only when a persistent WebSocket server is available
# (e.g. Railway deployment). On Vercel serverless, leave unset or "false" —
# the chat still works via REST polling.
VITE_CHAT_WS=false

# Payment gateway visibility (Vite build-time flag)
VITE_PAYPAL_ENABLED=false
